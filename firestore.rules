rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all to protect all undocumented paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for security validation
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(docId) {
      return docId is string && docId.size() <= 128 && docId.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Enterprise CRM system store - Strictly restricted to authenticated users
    match /crm_system/{docId} {
      allow read, write: if isSignedIn() && isValidId(docId);
    }
  }
}

