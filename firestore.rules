rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all to protect all undocumented paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for security validation
    function isValidId(docId) {
      return docId is string && docId.size() > 0 && docId.size() <= 128 && docId.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidWrite() {
      return request.resource.data.keys().hasAll(['payload']) &&
             request.resource.data.payload is map;
    }

    // Enterprise CRM system store - Persistent multi-device synchronization
    match /crm_system/{docId} {
      allow read: if isValidId(docId);
      allow create, update: if isValidId(docId) && isValidWrite();
      allow delete: if isValidId(docId);
    }
  }
}

